{
  "name": "smart-apartment-voice",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "verify": "node --experimental-strip-types --no-warnings scripts/verify.ts",
    "e2e": "node --experimental-strip-types --no-warnings scripts/e2e.ts",
    "bundle": "expo export --platform android --output-dir .expo-export"
  },
  "private": true
}
