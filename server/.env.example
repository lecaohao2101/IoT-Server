# ============================================================
#  Smart Apartment Server — example environment
#  Copy to .env and adjust. Never commit a real .env.
# ============================================================

APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# --- Security -------------------------------------------------
# Để trống chỉ hợp lệ khi APP_ENV=dev. Với staging/prod, thiếu API_KEY thì
# server TỪ CHỐI khởi động, trừ khi đặt ALLOW_ANONYMOUS=true một cách có ý thức.
API_KEY=
ALLOW_ANONYMOUS=false
# Chỉ định domain front-end thật khi triển khai; "*" cho phép mọi trang gọi API.
CORS_ORIGINS=*
# JSON map of device_id -> token for ESP32 units
DEVICE_TOKENS={}

# --- Home / safety descriptors --------------------------------
HOME_CONFIG_PATH=config/home.yaml
SAFETY_CONFIG_PATH=config/safety.yaml

# --- State store ----------------------------------------------
# Empty => in-process memory backend (single worker, dev only)
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=sa
CONVERSATION_TTL_S=1800
CONVERSATION_MAX_TURNS=12

# --- MQTT -----------------------------------------------------
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-apartment-server
MQTT_TLS=false
MQTT_BASE_TOPIC=home
MQTT_QOS=1

# --- AI providers: google | mock ------------------------------
STT_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock

GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
# Thay cho đường dẫn file: dán nguyên nội dung service account JSON.
# Dùng cho Fly/Cloud Run nơi secret chỉ tồn tại dưới dạng biến môi trường.
GOOGLE_CREDENTIALS_JSON=

STT_LANGUAGE=vi-VN
STT_MODEL=long

TTS_VOICE=vi-VN-Neural2-A
TTS_SPEAKING_RATE=1.05
TTS_PITCH=0.0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_S=15

# --- Audio ----------------------------------------------------
AUDIO_SAMPLE_RATE=16000
MAX_UTTERANCE_S=20
SILENCE_TIMEOUT_MS=900

# --- Trợ lý & từ khoá đánh thức --------------------------------
# Tên này vừa là tên trợ lý tự xưng, vừa là từ khoá phải gọi trước khi ra lệnh.
# Đổi tên ở đây là đổi cả hai, kể cả các câu mẫu người dùng đọc khi đăng ký giọng.
ASSISTANT_NAME=Anh Thạc Sĩ
WAKE_WORD_ENABLED=true
# Cách viết khác muốn chấp nhận thêm, phân tách bằng dấu phẩy.
WAKE_WORD_ALIASES=
# Độ giống tối thiểu để coi là đã gọi tên. Thấp hơn thì dễ gọi nhưng dễ tự bật.
WAKE_WORD_THRESHOLD=0.82
# Sau khi gọi tên, câu tiếp theo trong bao nhiêu giây thì không cần gọi lại.
# Đặt 0 nếu muốn mọi câu đều phải gọi tên.
WAKE_FOLLOW_UP_S=30

# --- Sinh trắc học giọng nói -----------------------------------
VOICE_VERIFICATION_ENABLED=true
VOICE_VERIFICATION_THRESHOLD=0.75
# Số mẫu (số câu phải đọc) để một hồ sơ giọng được coi là đăng ký xong.
VOICE_ENROLLMENT_SAMPLES=3
# Bật để từ chối mọi lệnh giọng nói khi chưa ai đăng ký giọng trong app.
VOICE_ENROLLMENT_REQUIRED=false

# Kiểm tra vân giọng TRÊN BOARD ESP32 hay không. Mặc định TẮT: board không có màn
# hình nên không ai đăng ký giọng từ đó được, mẫu duy nhất để so là mẫu thu bằng
# mic điện thoại -- khác mic, khác phòng, khác khoảng cách, và so lệch đủ nhiều
# để khoá chính chủ ra khỏi nhà mình. Từ khoá đánh thức vẫn luôn áp dụng cho board.
# App mobile KHÔNG bị ảnh hưởng, vẫn xác thực giọng như thường.
VOICE_VERIFICATION_ON_DEVICE=false
