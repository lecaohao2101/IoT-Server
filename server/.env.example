# ============================================================
#  Smart Apartment Server — example environment
#  Copy to .env and adjust. Never commit a real .env.
# ============================================================

APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# --- Security -------------------------------------------------
# Leave empty in dev to disable auth. Set in staging/prod (required).
API_KEY=
# JSON map of device_id -> token for ESP32 units
DEVICE_TOKENS={}

# --- Home / safety descriptors --------------------------------
HOME_CONFIG_PATH=config/home.yaml
SAFETY_CONFIG_PATH=config/safety.yaml

# --- State store ----------------------------------------------
# Empty => in-process memory backend (single worker, dev only)
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=sa
CONVERSATION_TTL_S=1800
CONVERSATION_MAX_TURNS=12

# --- MQTT -----------------------------------------------------
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-apartment-server
MQTT_TLS=false
MQTT_BASE_TOPIC=home
MQTT_QOS=1

# --- AI providers: google | mock ------------------------------
STT_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock

GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

STT_LANGUAGE=vi-VN
STT_MODEL=long

TTS_VOICE=vi-VN-Neural2-A
TTS_SPEAKING_RATE=1.05
TTS_PITCH=0.0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_S=15

# --- Audio ----------------------------------------------------
AUDIO_SAMPLE_RATE=16000
MAX_UTTERANCE_S=20
SILENCE_TIMEOUT_MS=900
