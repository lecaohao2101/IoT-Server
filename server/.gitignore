# Bổ sung cho .gitignore ở thư mục gốc.
# Giữ ở đây để thư mục `server/` vẫn tự đứng được nếu tách ra thành repo riêng.

__pycache__/
*.py[cod]
.venv/
venv/

.env
.env.*
!.env.example

*.log
*.wav
*.mp3
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Credentials Google Cloud — giữ thư mục, bỏ nội dung
credentials/*
!credentials/.gitkeep
*.json.key
config/speakers.json
